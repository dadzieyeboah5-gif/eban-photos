# ═══════════════════════════════════════════════════════════════
# eban photos — Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════════

# ── SERVER ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── FRONTEND URL (for CORS) ────────────────────────────────────
# Your GitHub Pages URL or custom domain
FRONTEND_URL=https://yourusername.github.io/eban-photos

# Path to frontend files (if serving from same server)
# FRONTEND_PATH=/var/www/eban-photos/public

# ── PAYSTACK ───────────────────────────────────────────────────
# Get these from https://dashboard.paystack.com/#/settings/developer
# IMPORTANT: Use TEST keys for development, LIVE keys for production

# Public key (safe to expose in frontend)
PAYSTACK_PUBLIC_KEY=STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Secret key (NEVER expose - backend only)
PAYSTACK_SECRET_KEY=your_secret_key_here

# ── JWT (Session Tokens) ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-64-characters-long
JWT_EXPIRES_IN=365d

# ── SIGNED URL SECRET ──────────────────────────────────────────
# For premium image URLs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNED_URL_SECRET=your-signed-url-secret-key

# ── PREMIUM IMAGES PATH ────────────────────────────────────────
# Absolute path to premium images directory
PREMIUM_IMAGES_PATH=/var/www/eban-photos/premium-images

# ── EMAIL (SMTP) ───────────────────────────────────────────────
# For booking notifications
# Leave empty to disable email notifications

# Gmail example (enable "Less secure apps" or use App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Generic SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="eban photos" <noreply@ebanphotos.com>

# Email to receive booking notifications
BOOKING_EMAIL=eban@ebanphotos.com

# ── ADMIN ──────────────────────────────────────────────────────
# Admin key for protected endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=your-admin-key-for-protected-endpoints
